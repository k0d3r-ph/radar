# Processo leve do Radar: sincronização, CSAT, estrelas, IA e Centrais.
VITE_RADAR_API_URL=http://localhost:5001

# Bot do WhatsApp: mensagens, status, conexão Socket.IO e rotas /api/whatsapp.
VITE_WHATSAPP_API_URL=http://localhost:5000

# Quando "true", o app conversa só com o Firebase Emulator Suite local (Firestore
# :8080, Auth :9099), sem gerar NENHUMA leitura/gravação em produção. Ver
# server/EMULADOR.md. Requer o emulador rodando e, para ter dados pra ver na tela,
# o seed (`npm run seed:emulador`, em server/).
VITE_USE_FIREBASE_EMULATOR=false
