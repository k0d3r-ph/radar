// ATENÇÃO: regras deliberadamente abertas, só para o Firebase Emulator Suite
// rodando local (ver server/EMULADOR.md) — nunca existe nenhum dado real atrás
// delas. As regras de produção são administradas direto no console do Firebase
// e não existem neste repositório; NUNCA rode "firebase deploy --only
// firestore:rules" com este arquivo.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
