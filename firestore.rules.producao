// Regras de PRODUÇÃO do Firestore depois da migração para o PostgreSQL (ver server/MIGRACAO_POSTGRES.md).
// Publicar manualmente no console do Firebase (Firestore > Regras) NA VIRADA, depois da cópia final
// dos dados. NÃO é usada pelo Emulator Suite. Nunca rode "firebase deploy --only firestore:rules"
// achando que publica este arquivo.
//
// O navegador não lê nem grava mais no Firestore: os dados ficam no PostgreSQL e as permissões
// por perfil passaram para a API (server/src/domain/regrasAcessoDados.ts, que reproduz as regras
// anteriores — histórico no git). Negar tudo impede que uma aba antiga, ainda aberta com a versão
// anterior do app, grave no banco abandonado. O Firebase Admin (script de migração) ignora estas
// regras e continua podendo ler o Firestore, que fica como cópia de segurança.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
