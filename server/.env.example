# Porta do bot do WhatsApp (processo "npm run dev" / index.ts). Padrão: 5000.
PORT=5000

# Porta da API leve: CSAT, ocorrências, sincronização, IA e Centrais
# (processo "npm run dev:api" / apiIndex.ts). Padrão: 5001.
# Precisa bater com VITE_RADAR_API_URL no app/.env (padrão: http://localhost:5001).
API_PORT=5001

# Origem liberada no CORS da API. Em desenvolvimento local, "*" (padrão) já funciona
# com o Vite; só restrinja para um domínio específico em produção.
CORS_ORIGIN=*

# Quando "true", o backend conversa só com o Firebase Emulator Suite local (Firestore
# e Auth), sem precisar de serviceAccountKey.json e sem gerar NENHUMA leitura/gravação
# em produção — inclusive a sincronização do SSX Desk, se SSX_DESK_API_KEY estiver
# preenchida. Ver server/EMULADOR.md. Requer o emulador rodando (`npm run emulators`).
USE_FIREBASE_EMULATOR=false

# Caminho do arquivo de credenciais do Firebase Admin (Service Account), relativo à
# raiz de server/. Sem esse arquivo, o backend sobe sem Firebase Admin: nenhuma rota
# que leia/grave no Firestore ou dependa de autenticação funciona.
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar
# nova chave privada. NUNCA versione esse arquivo nem cole o conteúdo dele aqui.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Bucket do Firebase Storage (ex.: nome-do-projeto.appspot.com), usado para anexos de
# mídia do WhatsApp. Opcional para rodar a API sem envio/recebimento de mídia.
FIREBASE_STORAGE_BUCKET=

# Chave da API Gemini, usada para gerar resumos de atendimento (rota /api/ia/resumir).
# Opcional: sem ela, só essa rota fica indisponível (demais recursos funcionam normalmente).
GEMINI_API_KEY=

# URL de exportação CSV da aba "Controle de Implantação" da planilha do CS.
# Formato: https://docs.google.com/spreadsheets/d/<ID_DA_PLANILHA>/export?format=csv&gid=<GID_DA_ABA>
# Exige que a planilha esteja com acesso geral "Qualquer pessoa com o link" (Leitor).
PLANILHA_CENTRAIS_CSV_URL=

# Opcional: URL de exportação CSV de uma segunda aba (ex.: clientes Ongoing) da
# mesma planilha. Mesmo formato acima, trocando o gid. A resolução de ID Central
# busca nas duas abas. Deixe vazio se não houver uma aba separada para Ongoing.
PLANILHA_CENTRAIS_ONGOING_CSV_URL=

# Chave exclusiva do backend, com escopo training-conversations:read.
SSX_DESK_API_KEY=
# Consulta na inicialização e a cada 5 minutos (mínimo: 60000).
SSX_DESK_SYNC_INTERVAL_MS=300000

# Chave da API de combinados da Manager Ops (Daily), gerada em Configurações > Times e
# acessos > Chaves da API. Sincroniza as tarefas do Radar com os combinados da daily nos
# dois sentidos — ver server/MANAGER_OPS.md. Sem ela, a sincronização fica desativada e
# o resto do Radar funciona normalmente.
MANAGER_OPS_API_KEY=
# Consulta na inicialização e a cada 5 minutos (mínimo: 60000).
MANAGER_OPS_SYNC_INTERVAL_MS=300000
