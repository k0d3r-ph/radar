# URL de exportação CSV da aba "Controle de Implantação" da planilha do CS.
# Formato: https://docs.google.com/spreadsheets/d/<ID_DA_PLANILHA>/export?format=csv&gid=<GID_DA_ABA>
# Exige que a planilha esteja com acesso geral "Qualquer pessoa com o link" (Leitor).
PLANILHA_CENTRAIS_CSV_URL=

# Chave exclusiva do backend, com escopo training-conversations:read.
SSX_DESK_API_KEY=
# Consulta na inicialização e a cada 5 minutos (mínimo: 60000).
SSX_DESK_SYNC_INTERVAL_MS=300000
