{
  "name": "radar-whatsapp-server",
  "version": "1.0.0",
  "description": "WhatsApp Automation Server for Radar CRM",
  "main": "dist/infrastructure/web/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/infrastructure/web/index.ts",
    "dev:api": "tsx watch src/infrastructure/web/apiIndex.ts",
    "build": "node scripts/patchWhatsAppMedia.mjs && tsc",
    "start": "node dist/infrastructure/web/index.js",
    "start:api": "node dist/infrastructure/web/apiIndex.js",
    "vincular-id-central": "tsx scripts/vincularIdCentral.ts",
    "atualizar-valores-contrato": "tsx scripts/atualizarValoresContrato.ts",
    "sincronizar-ssx-desk": "tsx scripts/sincronizarSsxDesk.ts",
    "sincronizar-manager-ops": "tsx scripts/sincronizarManagerOps.ts",
    "emulators": "firebase emulators:start --config ../firebase.json --import ../.emulator-data --export-on-exit",
    "seed:emulador": "tsx scripts/seedEmulador.ts",
    "seed:jornada": "tsx scripts/seedJornadaEmulador.ts",
    "test:validacao": "npm run build && node --test tests/validacaoConhecimento.test.mjs tests/tarefasAutomaticas.test.mjs tests/excluirTarefaConcluida.test.mjs tests/csat.test.mjs",
    "test:profile-photos": "npm run build && node --test tests/profilePhotos.test.mjs",
    "test:ssx-desk": "npm run build && node --test tests/ssxDesk.test.mjs",
    "test:manager-ops": "npm run build && node --test tests/managerOps.test.mjs",
    "test:favoritos": "npm run build && node --test tests/favoritos.test.mjs",
    "test:sincronizacao": "npm run build && node --test tests/sincronizacao.test.mjs",
    "test:whatsapp-media": "npm run build && node --test tests/whatsappMedia.test.mjs",
    "test:centrais": "npm run build && node --test tests/planilhaCentrais.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#main"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.5",
    "firebase-tools": "^13.35.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.3"
  }
}
